# DashScope（阿里云百炼）API Key，Qwen / embedding / rerank 共用
DASHSCOPE_API_KEY=

# DashScope OpenAI 兼容接口地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Postgres 连接串（对应 docker-compose.yml 的 postgres 服务）
DATABASE_URL=postgresql+psycopg://shoplens:shoplens@localhost:5432/shoplens

# 值得买海纳开放平台 API key（真实商品检索与知识图谱 MCP）
ZDM_API_KEY=

# Langfuse（默认关闭；开启时需同时填写公钥和私钥）
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0

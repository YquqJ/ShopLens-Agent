# DashScope（阿里云百炼）API Key，Qwen / embedding / rerank 共用
DASHSCOPE_API_KEY=

# DashScope OpenAI 兼容接口地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Postgres 连接串（对应 docker-compose.yml 的 postgres 服务）
DATABASE_URL=postgresql+psycopg://shoplens:shoplens@localhost:5432/shoplens

# Chroma 向量持久化目录（相对 backend 根，本地文件无独立容器）
CHROMA_DIR=chroma